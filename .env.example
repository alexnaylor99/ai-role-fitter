# Copy to .env and fill in your own values. .env is git-ignored — never commit it.

# LLM: claude | ollama | mock
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Local model (must stay on this machine: 127.0.0.1 / localhost / ::1)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_S=240

# Voice: auto (ElevenLabs if a key is set, otherwise typed answers) | elevenlabs | mock | none
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Target role profile
ROLE_PROFILE=app/roles/elevenlabs_fde.json

# Save interviews to the git-ignored sessions/ folder
SAVE_SESSIONS=false
